{
  "info": {
    "name": "Fuel Route Planner",
    "description": "Cheapest fuel stops between two US locations. Open the **Visualize** tab on any successful response to see the route and stops on a map.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "New York → Los Angeles (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const template = `",
              "<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\">",
              "<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>",
              "<style>",
              "  body { margin: 0; font: 13px system-ui, sans-serif; }",
              "  #summary { padding: 8px 12px; background: #f5f7fa; }",
              "  #map { height: 560px; }",
              "</style>",
              "<div id=\"summary\"></div>",
              "<div id=\"map\"></div>",
              "<script>",
              "  pm.getData((err, plan) => {",
              "    const s = plan.summary;",
              "    document.getElementById(\"summary\").innerHTML =",
              "      \"<b>\" + plan.start.label + \" → \" + plan.finish.label + \"</b> · \" +",
              "      s.total_distance_miles + \" mi · <b>$\" + s.total_fuel_cost.toFixed(2) + \"</b> fuel · \" +",
              "      s.number_of_fuel_stops + \" stops\";",
              "    const map = L.map(\"map\");",
              "    L.tileLayer(\"https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}\", { maxZoom: 18, attribution: \"Powered by Esri\" }).addTo(map);",
              "    const line = L.geoJSON(plan.route, { style: { color: \"#2f6fde\", weight: 4 } }).addTo(map);",
              "    map.fitBounds(line.getBounds(), { padding: [20, 20] });",
              "    L.circleMarker([plan.start.lat, plan.start.lon], { radius: 7, color: \"#2f9e44\", fillOpacity: 1 }).addTo(map);",
              "    L.circleMarker([plan.finish.lat, plan.finish.lon], { radius: 7, color: \"#1f2933\", fillOpacity: 1 }).addTo(map);",
              "    plan.fuel_stops.forEach((f) => {",
              "      L.marker([f.lat, f.lon]).bindPopup(",
              "        \"<b>\" + f.stop_number + \". \" + f.name + \"</b><br>\" + f.city + \", \" + f.state +",
              "        \"<br>$\" + f.price_per_gallon.toFixed(3) + \"/gal · \" + f.gallons_purchased.toFixed(1) +",
              "        \" gal · <b>$\" + f.cost.toFixed(2) + \"</b>\"",
              "      ).bindTooltip(String(f.stop_number), { permanent: true, direction: \"top\" }).addTo(map);",
              "    });",
              "  });",
              "</script>`;",
              "",
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "const plan = pm.response.json();",
              "pm.test(\"total cost equals the sum of the stops\", () => {",
              "  const sum = plan.fuel_stops.reduce((acc, f) => acc + f.cost, 0);",
              "  pm.expect(plan.summary.total_fuel_cost).to.be.closeTo(sum, 0.05);",
              "});",
              "pm.test(\"at most one routing API call\", () => pm.expect(plan.external_api_calls.routing).to.be.at.most(1));",
              "pm.visualizer.set(template, plan);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Coast to coast. Both cities resolve from the bundled gazetteer, so the only external call is one OSRM route.",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
